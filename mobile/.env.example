# Application mobile ClairDossier — copier en .env (jamais commité).
#
# RÈGLE : tout ce qui est listé ici est EMBARQUÉ DANS LE BUNDLE et doit donc
# être considéré comme PUBLIC. Aucune clé de service, aucun secret serveur,
# aucune clé d'IA ne doit figurer dans ce fichier ni dans app.config.ts.
#
# La clé « anon » Supabase est publique par conception : la protection réelle
# est assurée par les policies Row Level Security de la base.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Environnement applicatif : development | preview | production
EXPO_PUBLIC_ENV=development

# Site public (liens légaux, réinitialisation de mot de passe, liens profonds)
EXPO_PUBLIC_SITE_URL=https://www.clair-dossier.com
