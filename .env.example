# Copier en .env (gitignored). Valeurs réelles dans les variables d'env Netlify.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# LDI — la clé Anthropic n'est JAMAIS une variable VITE_* : tout ce qui porte ce
# préfixe est inliné dans le bundle navigateur, donc public. Elle se configure en
# secret de la fonction edge :
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-…
#
# Plafond de dépense par dossier, en dollars estimés (défaut : 5). Contrôlé
# AVANT l'appel facturé ; sans lui, une boucle de relance n'est bornée par rien.
#   supabase secrets set LDI_PLAFOND_DOSSIER_DOLLARS=5
#
# Identifiant de modèle (défaut : claude-opus-5).
#   supabase secrets set LDI_MODEL=claude-opus-5
#
# Tarifs de l'estimation de coût, en dollars par million de jetons. Les valeurs
# par défaut sont DÉCLARÉES dans le code et n'ont été confrontées à aucune
# grille officielle : tant qu'elles ne sont pas fixées ici, l'estimation porte
# « non vérifié ». La date du relevé est affichée telle quelle.
#   supabase secrets set LDI_TARIF_ENTREE=… LDI_TARIF_SORTIE=…
#   supabase secrets set LDI_TARIF_CACHE_LU=… LDI_TARIF_CACHE_ECRIT=…
#   supabase secrets set LDI_TARIFS_VERIFIE_LE=2026-08-18
#
# Voir docs/LDI.md, § 9.

# LDI — sources officielles, en LIGNE DE COMMANDE (`npm run ldi -- sourcer`).
#   LDI_JUDILIBRE_URL=https://api.piste.gouv.fr/cassation/judilibre/v1.0/
#   LDI_JUDILIBRE_ENTETE=KeyId
#   LDI_JUDILIBRE_CLE=<clé PISTE>
#   LDI_LEGIFRANCE_URL=…  LDI_LEGIFRANCE_ENTETE=…  LDI_LEGIFRANCE_CLE=…

# LDI — recherche juridique depuis le navigateur, via la fonction edge
# `ldi-jurisprudence`. Aucune de ces valeurs n'est un VITE_* : une clé PISTE
# livrée au navigateur serait lisible par quiconque ouvre les outils de
# développement, et les quotas sont attachés à l'opérateur.
#   supabase secrets set LDI_PISTE_CLIENT_ID=… LDI_PISTE_CLIENT_SECRET=…
#   supabase secrets set LDI_PISTE_OAUTH_URL=https://oauth.piste.gouv.fr/api/oauth/token
#   supabase secrets set LDI_JUDILIBRE_URL=https://api.piste.gouv.fr/cassation/judilibre/v1.0/
#
# Absents, la fonction répond 503 « source non configurée » et l'écran le dit :
# elle ne produit jamais de décision plausible en attendant mieux.
#
# ATTENTION — cette intégration n'a JAMAIS été exercée contre le service PISTE
# réel : ce dépôt ne détient aucun identifiant. Lire la liste de ce qui reste à
# confirmer dans docs/RECHERCHE-JURIDIQUE.md AVANT de la déployer.
