{
  "name": "clairdossier-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:md": "tsx scripts/gen-markdown.ts",
    "ldi": "tsx scripts/ldi.ts",
    "test:ldi": "tsx --test \"src/ldi/__tests__/*.test.ts\"",
    "build": "npm run gen:md && tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ldi:artifact": "node scripts/build-artifact.mjs",
    "ldi:sync-edge": "node -e \"for (const f of ['prompt.ts','citations.ts']) require('node:fs').copyFileSync('src/ldi/'+f,'supabase/functions/ldi-analyze/'+f)\""
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@supabase/supabase-js": "^2.108.2",
    "fflate": "^0.8.3",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
