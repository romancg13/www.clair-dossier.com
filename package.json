{
  "name": "clairdossier-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:md": "tsx scripts/gen-markdown.ts",
    "gen:etalon": "tsx scripts/gen-dossier-etalon.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "build": "npm run gen:md && tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "tests/db/apply-migrations.sh --reset && vitest run tests/db"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@supabase/supabase-js": "^2.108.2",
    "fflate": "^0.8.3",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unpdf": "^1.8.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
